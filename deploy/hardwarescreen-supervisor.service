[Unit]
Description=Trofeo Vision 11.3 LCD dashboard (reactive renderer + USB reconnect)
After=multi-user.target

[Service]
Type=simple
# Adjust the venv/project paths to your install. `hardwarescreen run` handles USB
# reconnect itself; Restart only kicks in if the process crashes.
# Alternative: wrap trcc-linux as the engine (verified: connects as 11.3/1920x440/model 69):
#   ExecStart=%h/.venv/bin/hardwarescreen supervise --cmd %h/.venv-trcc/bin/trcc daemon
ExecStart=%h/.venv-trcc/bin/hardwarescreen run --config %h/hardwarescreen/config.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target